# Copia este archivo como .env en el backend (no en el frontend) y completa los valores.
# No subas el .env real a Git ni incluyas estas credenciales en archivos JavaScript públicos.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CitasPegy
DB_USER=usuario_sql
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# URL pública del backend que atiende la API de recuperación.
CITASPEGY_API_URL=http://localhost:3000

# Configuración del proveedor de correo (el backend la usa para enviar códigos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Configuración opcional de proveedor SMS. Guardar credenciales solo en el backend.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER=
